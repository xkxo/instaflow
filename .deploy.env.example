# Copy to `.deploy.env` (git-ignored) and fill in; then deploy with:  npm run deploy
# Server prerequisites (one-time): see README → "Your own server (VPS)".

# SSH target. Key-based login recommended (ssh-copy-id), so deploys need no password.
DEPLOY_HOST=root@203.0.113.10

# Public origin the app is reached at (no trailing slash, no path).
PUBLIC_URL=https://example.com

# Sub-path the app is served under; empty for the domain root.
BASE_PATH=/instaflow

# Optional overrides (defaults shown).
# APP_DIR=/var/www/instaflow
# SERVICE=instaflow
# ENV_FILE=/etc/instaflow/instaflow.env
# APP_PORT=3200
