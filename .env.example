# Copy to `.env` (git-ignored). Both Next.js and the Prisma CLI read this file.
# Tip: `npm run gen-secrets` prints fresh values for SESSION_SECRET, TOKEN_ENCRYPTION_KEY, CRON_SECRET
# and META_WEBHOOK_VERIFY_TOKEN.

# ── Database ────────────────────────────────────────────────────────────────
# Connection string the app uses at runtime. On Neon/Supabase use the POOLED URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Direct (non-pooled) URL used only by Prisma migrations.
# Optional: leave empty to use DATABASE_URL for migrations too.
DIRECT_URL=""

# Only needed when using `npx prisma dev` locally: its shadow database URL
# (same as DATABASE_URL but with the shadow port, usually DATABASE port + 1).
SHADOW_DATABASE_URL=""

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs session cookies. At least 32 random characters.
# Changing it logs out every existing session.
SESSION_SECRET=""

# bcrypt hash of your login password. Generate with:  npm run hash-password
# IMPORTANT: in this file every $ must be escaped as \$ (the script prints it that way).
# In the Vercel/Railway dashboard, paste the raw, unescaped hash instead.
APP_PASSWORD_HASH=""

# ── Instagram (Instagram API with Unified Login) ───────────────────────────
# Meta app ID and app secret: App Dashboard → App settings → Basic.
# These are the META app's credentials, not an "Instagram app ID/secret".
META_APP_ID=""
META_APP_SECRET=""

# Config ID of the Unified Login configuration (Use cases → Manage messaging & content on
# Instagram → Customize → API setup with Unified login). Not a secret.
META_LOGIN_CONFIG_ID=""

# Must exactly match the redirect URL saved in the login configuration. Must be HTTPS.
# Local dev: use an HTTPS tunnel URL, e.g. https://your-name.ngrok-free.app/api/instagram/callback
META_REDIRECT_URI="https://your-domain.com/api/instagram/callback"

# Any random string. Paste the same value as "Verify token" when configuring webhooks in the
# App Dashboard (API setup with Unified login → Configure webhooks).
META_WEBHOOK_VERIFY_TOKEN=""

# 32 random bytes, base64 (or 64 hex chars). Encrypts the Instagram token at rest (AES-256-GCM).
# Changing it makes the stored token unreadable; you'd need to reconnect Instagram.
TOKEN_ENCRYPTION_KEY=""

# ── Flow engine ─────────────────────────────────────────────────────────────
# Timezone for the dashboard's "Today" (IANA name, e.g. Europe/London). Default: UTC.
APP_TIMEZONE=""

# The in-process job poller runs on long-running servers (Railway, next start/dev).
# Set to "off" to disable it. On Vercel it never runs; call /api/cron/jobs instead.
JOB_POLLER=""

# ── Cron ────────────────────────────────────────────────────────────────────
# Protects /api/cron/*. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
